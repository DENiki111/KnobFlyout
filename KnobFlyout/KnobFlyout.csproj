<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KnobFlyout</RootNamespace>
    <AssemblyName>KnobFlyout</AssemblyName>
    <!-- Name und Herausgeber der exe (Task-Manager „Autostart-Apps“, Eigenschaften) -->
    <AssemblyTitle>KnobFlyout</AssemblyTitle>
    <Product>KnobFlyout</Product>
    <Company>KnobFlyout</Company>
    <Version>1.6.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <!-- Release-Builds enthalten keinen lokalen Pfad des Build-Rechners -->
    <PathMap Condition="'$(Configuration)'=='Release'">$(MSBuildProjectDirectory)=KnobFlyout</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.0.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf.NetCore" Version="1.0.18" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
  </ItemGroup>

</Project>
